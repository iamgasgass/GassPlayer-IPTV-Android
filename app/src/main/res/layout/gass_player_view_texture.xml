<?xml version="1.0" encoding="utf-8"?>
<!--
  TextureView is used on Android phones because it participates in the normal
  View/Compose rendering hierarchy. This avoids SurfaceView/z-order glitches
  when the immersive player's Compose controls fade out or interactive overlays
  change. Android TV keeps the more efficient default SurfaceView.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
